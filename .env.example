# Bu dosyayı .env olarak kopyalayin ve degerleri doldurun.
# .env dosyasi .gitignore icindedir — asla paylasilmaz.

# Calisma modu: dry_run | testnet | live
#  dry_run : API anahtari GEREKMEZ. Gercek veriyle sinyal uretir, emirleri simule eder.
#  testnet : testnet.binance.vision anahtarlari ile sanal emir gonderir.
#  live    : GERCEK PARA. Ancak tum testler bittikten sonra.
BOT_MODE=dry_run

# Binance Spot Testnet anahtarlari (testnet.binance.vision — GitHub ile ucretsiz)
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Gercek hesap anahtarlari (SADECE live modda gerekli; Withdrawal izni KAPALI olmali!)
BINANCE_LIVE_KEY=
BINANCE_LIVE_SECRET=

# Telegram bildirimleri (bos birakilirsa bildirim gonderilmez)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strateji / risk ayarlari (istege bagli; varsayilanlar config.py icinde)
# 2022-2026 BTC/ETH/SOL backtest taramasina gore secilen varsayilanlar:
# 1h dilim komisyon nedeniyle ZARAR etti; 4h + ATR 3.0 uc paritede de karli cikti.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=4h
RISK_PCT=0.02
ATR_MULTIPLIER=3.0
MAX_DAILY_LOSS_PCT=0.05
DAILY_REPORT_HOUR=21
