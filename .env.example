# Bu dosyayı .env olarak kopyalayin ve degerleri doldurun.
# .env dosyasi .gitignore icindedir — asla paylasilmaz.

# Calisma modu: dry_run | testnet | live | futures_paper
#  dry_run       : Spot simulasyon. API anahtari GEREKMEZ.
#  futures_paper : Vadeli islem (USDT-M) simulasyonu — kaldirac + long/short,
#                  gercek fiyat + gercek komisyon/funding matematigi, sanal para.
#                  Panel ile izlenir: python -m src.panel
#  testnet       : testnet.binance.vision anahtarlari ile sanal spot emir.
#  live          : GERCEK PARA. Ancak tum testler bittikten sonra.
BOT_MODE=futures_paper

# --- Vadeli islem ayarlari (futures_paper) ---
# Kaldirac pozisyonu BUYUTMEZ (boyutu risk yonetimi belirler), sadece bakiye
# tavanini gevsetir. Backtest: 2x ideal, 3x+ hicbir sey eklemiyor.
LEVERAGE=2
ALLOW_LONG=true
# DIKKAT: Short 2022-2026 backtestinde 9/9 konfigurasyonda ZARAR etti.
# Acmak isterseniz true yapin — paper modda risksiz gozlemleyin.
ALLOW_SHORT=false
PANEL_PORT=8484

# Binance Spot Testnet anahtarlari (testnet.binance.vision — GitHub ile ucretsiz)
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Gercek hesap anahtarlari (SADECE live modda gerekli; Withdrawal izni KAPALI olmali!)
BINANCE_LIVE_KEY=
BINANCE_LIVE_SECRET=

# Telegram bildirimleri (bos birakilirsa bildirim gonderilmez)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strateji / risk ayarlari (istege bagli; varsayilanlar config.py icinde)
# 2022-2026 BTC/ETH/SOL backtest taramasina gore secilen varsayilanlar:
# 1h dilim komisyon nedeniyle ZARAR etti; 4h + ATR 3.0 uc paritede de karli cikti.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TIMEFRAME=4h
RISK_PCT=0.02
ATR_MULTIPLIER=3.0
MAX_DAILY_LOSS_PCT=0.05
DAILY_REPORT_HOUR=21

# Gunluk trend teyidi (A/B testi: SOL'da fayda, BTC/ETH'de zarar -> tutarsiz, varsayilan KAPALI)
USE_DAILY_FILTER=false

# Giris emri: once maker limit dene (dusuk komisyon), dolmazsa market'e don.
# NOT: Binance hesabinizda "BNB ile komisyon ode" secenegini acmayi unutmayin
# (%0.10 -> %0.075) ve cuzdanda az miktar BNB bulundurun.
USE_LIMIT_ENTRY=true
LIMIT_ENTRY_TIMEOUT_S=45
